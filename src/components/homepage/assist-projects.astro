---
import { ASSIST_PROJECTS, splitTechnologies } from "../../shared/const";
---

<ol class="panel divide-y divide-line">
  {
    ASSIST_PROJECTS.map((project: any, index: number) => {
      const num = String(index + 1).padStart(2, "0");
      const technologies = splitTechnologies(project.technologies);

      return (
        <li class="grid grid-cols-[2rem_1fr] gap-x-4 gap-y-3 p-5 transition-colors hover:bg-subtle sm:p-6">
          <span class="pt-0.5 text-sm tabular-nums text-muted">{num}</span>

          <div>
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <h3 class="font-bold leading-snug">{project.name}</h3>
              {project.role && (
                <span class="eyebrow shrink-0 sm:text-right">{project.role}</span>
              )}
            </div>

            {project.description && (
              <p class="mt-3 text-sm leading-relaxed text-fg/85">
                {project.description}
              </p>
            )}

            {technologies.length > 0 && (
              <p class="mt-3 text-xs uppercase tracking-wider text-muted">
                {technologies.join(" · ")}
              </p>
            )}

            {project.responsibilities && (
              <p class="mt-3 text-sm leading-relaxed text-muted">
                {project.responsibilities}
              </p>
            )}
          </div>
        </li>
      );
    })
  }
</ol>
