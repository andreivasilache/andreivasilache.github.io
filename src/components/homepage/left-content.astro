---
import Image from "astro/components/Image.astro";
import me from "../../assets/me.jpg";
import { AiOutlineX, AiOutlineGithub, AiOutlineLinkedin } from "react-icons/ai";

const facts = [
  { label: "role", text: "Software Engineer @ Assist Software", href: "https://assist-software.net" },
  { label: "based", text: "Suceava, Romania" },
  { label: "seen", text: "Germany · Italy · Greece" },
  { label: "fuel", text: "Espresso, always" },
];

const socials = [
  { href: "https://github.com/andreivasilache", label: "GitHub", Icon: AiOutlineGithub, size: 21 },
  { href: "https://www.linkedin.com/in/vasilache-andrei-741a1a158/", label: "LinkedIn", Icon: AiOutlineLinkedin, size: 21 },
  { href: "https://x.com/andreiv_andrei", label: "X", Icon: AiOutlineX, size: 19 },
];
---

<section class="grid items-end gap-8 sm:grid-cols-[1fr_1.1fr]">
  <Image
    src={me}
    alt="Vasilache Andrei"
    class="aspect-[4/5] w-full border border-line object-cover object-[center_60%] sm:aspect-auto sm:object-center"
    loading="eager"
    width={1000}
    priority
    fetchpriority="high"
    format="webp"
  />

  <div>
    <p class="eyebrow" data-decode data-decode-delay="650">Software Development Engineer III</p>
    <h1 class="mt-2 text-3xl font-bold leading-[1.05] tracking-tight sm:text-4xl" data-decode data-decode-delay="850">Vasilache Andrei</h1>

    <dl class="mt-6 space-y-2 text-sm">
      {
        facts.map((f) => (
          <div class="flex gap-4">
            <dt class="w-14 shrink-0 text-muted lowercase">{f.label}</dt>
            <dd>
              {f.href ? (
                <a
                  href={f.href}
                  target="_blank"
                  class="link"
                  data-umami-event="outbound"
                  data-umami-event-label={f.label}
                >
                  {f.text}
                </a>
              ) : (
                f.text
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-7 flex items-center gap-5">
      {
        socials.map(({ href, label, Icon, size }) => (
          <a
            href={href}
            target="_blank"
            aria-label={label}
            class="text-fg transition-opacity hover:opacity-60"
            data-umami-event="social-click"
            data-umami-event-network={label}
          >
            <Icon size={size} />
          </a>
        ))
      }

      <span class="h-4 w-px bg-line"></span>

      <a
        href="mailto:vasilacheandrei46@gmail.com"
        class="btn"
        data-umami-event="email-click"
        data-umami-event-location="hero"
        >Email me</a
      >
    </div>
  </div>
</section>
