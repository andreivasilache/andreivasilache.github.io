---
import LeftContent from "../components/homepage/left-content.astro";
import AssistProjects from "../components/homepage/assist-projects.astro";
import FreelancingRenderer from "../components/homepage/freelancing-renderer";
import AssistEvents from "../components/homepage/assist-events.astro";
import Testimonials from "../components/homepage/testimonials.astro";
import SectionHead from "../components/SectionHead.astro";
import ReadingNav from "../components/homepage/reading-nav.astro";

import Layout from "../layouts/Layout.astro";

const PREVIOUS_EXPERIENCE = 1;

const startDate = new Date(2019, 6) as unknown as number; // July is month 6 (0-indexed)
const today = new Date() as unknown as number;
const yearsDifference =
  Math.floor((today - startDate) / (1000 * 60 * 60 * 24 * 365.25)) +
  PREVIOUS_EXPERIENCE;
---

<Layout>
  <ReadingNav />

  <LeftContent />

  <section class="mt-20 scroll-mt-24" id="about">
    <SectionHead id="about" />
    <div class="prose-block">
      <p>
        I'm curious by nature and always looking for ways to make life a little
        smarter and easier through technology. I love exploring new ideas,
        whether it's experimenting with AI, building apps, or dreaming up
        projects that could one day grow into something bigger.
      </p>
      <p>
        Outside of work, I love traveling, listening, and engaging in
        interesting conversations that spark new ideas. I'm passionate about
        helping others, and this site is a space where I share a bit of who I am
        and the projects I'm working on to make a positive impact.
      </p>
    </div>
  </section>

  <section class="mt-20 scroll-mt-24" id="education">
    <SectionHead id="education" />
    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <div>
        <h3 class="font-bold">Economic Informatics</h3>
        <p class="mt-1 text-sm text-muted">
          Ştefan cel Mare University of Suceava
        </p>
      </div>
      <span class="text-sm tabular-nums text-muted">2019 – 2022</span>
    </div>
  </section>

  <section class="mt-20 scroll-mt-24" id="experience">
    <SectionHead id="experience" />
    <p class="prose-block">
      I'm currently a Software Engineer at Assist Software, with almost <b
        class="text-fg">{yearsDifference} years of experience</b
      >. I've contributed to a wide range of projects — names are withheld under
      confidentiality agreements.
    </p>

    <div class="mt-7">
      <AssistProjects />
    </div>

    <AssistEvents />
  </section>

  <section class="mt-20 scroll-mt-24" id="testimonials">
    <SectionHead id="testimonials" />
    <Testimonials />
  </section>

  <FreelancingRenderer client:load />
</Layout>
